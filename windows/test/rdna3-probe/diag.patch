+#ifdef _WIN32
+#define NOMINMAX
+#include <windows.h>
+// A crash prints where it happened (module, offset, the address touched) and a short stack, to stderr.
+static void describe(void* address, char* out, size_t size) {
+    HMODULE module = nullptr;
+    char name[MAX_PATH] = "?";
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (LPCSTR)address, &module) && module) GetModuleFileNameA(module, name, MAX_PATH);
+    const char* slash = std::strrchr(name, '\\');
+    std::snprintf(out, size, "%s+0x%llx", slash ? slash + 1 : name, (unsigned long long)((char*)address - (char*)module));
+}
+static LONG WINAPI crash_filter(EXCEPTION_POINTERS* e) {
+    const EXCEPTION_RECORD* r = e->ExceptionRecord;
+    char where[400];
+    describe(r->ExceptionAddress, where, sizeof where);
+    std::fprintf(stderr, "[crash] exception 0x%08lx at %s (exe loaded at %p)\n", r->ExceptionCode, where, (void*)GetModuleHandleW(nullptr));
+    if (r->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && r->NumberParameters >= 2)
+        std::fprintf(stderr, "[crash] %s address %p\n", r->ExceptionInformation[0] == 0 ? "reading" : r->ExceptionInformation[0] == 1 ? "writing" : "executing", (void*)r->ExceptionInformation[1]);
+    void* frames[62];
+    const USHORT count = CaptureStackBackTrace(0, 62, frames, nullptr);
+    for (USHORT i = 0; i < count; ++i) { describe(frames[i], where, sizeof where); std::fprintf(stderr, "[crash]   #%u %s\n", unsigned(i), where); }
+    std::fflush(stderr);
+    return EXCEPTION_EXECUTE_HANDLER;
+}
+#endif
+
 int main(int argc, char** argv) try {
+#ifdef _WIN32
+    SetUnhandledExceptionFilter(crash_filter);
+#endif
+    if (std::getenv("RUN_FRAME_TEST_CRASH")) *(volatile int*)0 = 1;   // exercises the crash report
     if (argc < 6) { std::fprintf(stderr, "usage: run_frame <root> <in.rgba8> <w> <h> <out.rgba8> [timed passes]\n"); return 2; }
     const uint32_t width = uint32_t(atoi(argv[3])), height = uint32_t(atoi(argv[4]));
     const int timed = argc > 6 ? atoi(argv[6]) : 0;
