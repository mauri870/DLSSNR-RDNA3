#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shared_memory_block : require
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) buffer OutF { float outf[]; };
layout(set = 0, binding = 1, std430) buffer InH { float16_t inh[]; };
layout(push_constant) uniform P { uint off; uint stride; } pc;
#define FA coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define FB coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define FC coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
#define FC16 coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
#define ROW gl_CooperativeMatrixLayoutRowMajor
#define COL gl_CooperativeMatrixLayoutColumnMajor
shared Blk { float16_t lx[512]; float16_t ly[512]; };
void main() {
  const uint t = gl_LocalInvocationID.x;
  for (uint i = t; i < 512u; i += 32u) { lx[i] = inh[i & 255u]; ly[i] = inh[(i + 7u) & 255u]; }
  barrier();

  FA a; FB b;
  coopMatLoad(a, lx, 0u, 16u, ROW);
  coopMatLoad(b, ly, 0u, 16u, COL);
  FC c = FC(0.0);
  c = coopMatMulAdd(a, b, c);
  coopMatStore(c, outf, 0u, 16u, ROW);
}
