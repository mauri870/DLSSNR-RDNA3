#version 460
#extension GL_GOOGLE_include_directive : require
// [Preprocess] on a wilsjo2 layer (ours), as the RenoDX-style layer does it: in the layer's own processing, from the
// frame's light (wilsjo2_light.comp, brought to the model's extent by the same resampling the proxy had), not inside
// the network's runtime from the encoded proxy. The math is prep_math.glsl's (shared with RenoDX's).
//
//   meter   (built with -DMETER, one 16 x 16 group): the auto exposure over the light at the model's extent (a)
//   forward (mode kPrepForward): the network's input enc(T(light)) from the light (t0) into a
//   back    (mode kPrepBack): the network's change taken back to the proxy's domain - d from the network's input (t0)
//           and answer (t1) through T's inverse (or as a ratio, RATIO), added to the light (t2), re-encoded as the
//           encode encodes (KIND), and added to the proxy P (t3) as a difference: M = P + E(p + d) - E(p), into a.
//           When the network changed nothing, M is P bit for bit.
//
// The meter's state (smoothed log2 gain, valid, gain, target) is a 1 x 1 RGBA32F image of the layer's own (state),
// read by every mode and written by the meter.
#ifdef METER
layout(local_size_x = 16, local_size_y = 16) in;
#else
layout(local_size_x = 8, local_size_y = 8) in;
#endif
layout(set = 0, binding = 0) uniform sampler2D t0;
layout(set = 0, binding = 1) uniform sampler2D t1;
layout(set = 0, binding = 2) uniform sampler2D t2;
layout(set = 0, binding = 3) uniform sampler2D t3;
layout(set = 0, binding = 4, rgba32f) uniform image2D a;
layout(set = 0, binding = 5, rgba32f) uniform image2D state;
layout(push_constant, std430) uniform Push {
    uint mode;            // the stage's Mode (kPrepMeter / kPrepForward / kPrepBack)
    float unused;
    uint width, height;   // the model's extent
    uint flags, curve;
    float bias, contrast, saturation, k, cap;
    float dt;             // seconds since the layer's last metered frame
    uint rmode;           // the encode's highlight curve (ReversibleMode: 0 the soft knee, 1 / 2 Neutwo, 3 / 4 hybrid)
    uint kind;            // what the proxy is: 0 HDR (knee + sRGB), 1 SDR (sRGB), 2 light as it is (a float frame
                          // the game does not flag HDR, passed through)
} pc;

const uint AUTO = 1u, UNKNEE = 2u, RESET = 8u, RATIO = 16u;
const uint kPrepForward = 62u;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

struct StateT { float s[4]; };
StateT st;

vec3 enc(vec3 v) {
    v = clamp(v, 0.0, 1.0);
    return mix(v * 12.92, 1.055 * pow(max(v, vec3(1e-8)), vec3(1.0 / 2.4)) - 0.055, step(0.0031308, v));
}
vec3 dec(vec3 v) {
    v = clamp(v, 0.0, 1.0);
    return mix(v / 12.92, pow((v + 0.055) / 1.055, vec3(2.4)), step(0.04045, v));
}
// The encode's highlight curves (wilsjo2_common.glsl 7.6 - 7.8, as prep_math.glsl has them): Curve = none on an
// HDR frame is the layer's own curve (UNKNEE).
float maxch(vec3 v) { return max(v.r, max(v.g, v.b)); }
vec3 neutwo_encode(vec3 v) {
    v = max(v, vec3(0.0));
    const float m = maxch(v);
    if (m <= 1e-6) return v;
    return v * inversesqrt(m * m + 1.0);
}
vec3 neutwo_decode(vec3 y) {
    y = max(y, vec3(0.0));
    const float m = min(maxch(y), 0.999999);
    if (m <= 1e-6) return y;
    return y * inversesqrt(max(1.0 - m * m, 1e-8));
}
float hybrid(float m) {
    if (m <= 0.75) return m;
    const float e = (m - 0.75) / 0.25;
    return 0.75 + 0.25 * (e * inversesqrt(e * e + 1.0));
}
float hybrid_inv(float y) {
    if (y <= 0.75) return y;
    const float u = min((y - 0.75) / 0.25, 0.999999);
    return 0.75 + 0.25 * (u * inversesqrt(max(1.0 - u * u, 1e-8)));
}
vec3 hybrid_encode(vec3 v) {
    v = max(v, vec3(0.0));
    const float m = maxch(v);
    if (m <= 1e-6) return v;
    return v * (hybrid(m) / m);
}
vec3 hybrid_decode(vec3 y) {
    y = max(y, vec3(0.0));
    const float m = maxch(y);
    if (m <= 1e-6) return y;
    return y * (hybrid_inv(m) / m);
}
vec3 knee(vec3 d) {
    if (pc.rmode != 0u) return clamp(pc.rmode >= 3u ? hybrid_encode(d) : neutwo_encode(d), 0.0, 1.0);
    const float l = dot(d, LUMA);
    if (l > 0.75) d *= (0.75 + 0.25 * (1.0 - exp(-(l - 0.75) / 0.25))) / l;
    const float peak = max(d.r, max(d.g, d.b));
    if (peak > 1.0) d /= peak;
    return d;
}
vec3 knee_inv(vec3 d) {
    if (pc.rmode != 0u) return pc.rmode >= 3u ? hybrid_decode(d) : neutwo_decode(d);
    const float l = dot(d, LUMA);
    if (l <= 0.75) return d;
    const float lc = min(l, 0.75 + 0.25 * (1.0 - 1e-6));
    return d * ((0.75 - 0.25 * log(1.0 - (lc - 0.75) / 0.25)) / l);
}
bool unknee() { return (pc.flags & UNKNEE) != 0u; }
// what `a` holds for the meter is light already
vec3 light(vec3 P) { return max(P, vec3(0.0)); }
vec3 light_at(vec3 P, ivec2 xy) { return light(P); }   // prep_math.glsl's meter: no kept frame here

#include "prep_math.glsl"

// The proxy's encoding of light (the encode's: wilsjo2_encode.comp), for the back's difference.
vec3 encode_as_proxy(vec3 v) { return pc.kind == 0u ? enc(knee(v)) : pc.kind == 1u ? enc(v) : v; }

void main() {
    const vec4 sv = imageLoad(state, ivec2(0));
    st.s[0] = sv.x; st.s[1] = sv.y; st.s[2] = sv.z; st.s[3] = sv.w;
#ifdef METER
    meter();
    if (gl_LocalInvocationIndex == 0u) imageStore(state, ivec2(0), vec4(st.s[0], st.s[1], st.s[2], st.s[3]));
#else
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= int(pc.width) || xy.y >= int(pc.height)) return;
    if (pc.mode == kPrepForward) {
        const vec4 L = texelFetch(t0, xy, 0);
        // Only the network input substitutes zero for a bad pixel; the back step retains its original.
        imageStore(a, xy, finite(L.rgb) ? vec4(enc(forward(max(L.rgb, vec3(0.0)))), L.a) : vec4(0.0, 0.0, 0.0, L.a));
        return;
    }
    const vec4 nin = texelFetch(t0, xy, 0), nout = texelFetch(t1, xy, 0), L = texelFetch(t2, xy, 0),
               P = texelFetch(t3, xy, 0);
    vec3 M = P.rgb;
    if (nout.rgb != nin.rgb && finite(nout.rgb) && finite(L.rgb) && finite(P.rgb)) {
        const vec3 din = dec(nin.rgb), dout = dec(nout.rgb);
        const vec3 p = max(L.rgb, vec3(0.0));
        vec3 d;
        if ((pc.flags & RATIO) != 0u) {
            // [Preprocess] Inverse = 0: the change as its ratio in the picture the network was shown
            d = p * (clamp(max(dout, vec3(1.0 / 1024.0)) / max(din, vec3(1.0 / 1024.0)), 0.25, 4.0) - 1.0);
        } else {
            d = backward(dout) - backward(din);
            const vec3 lim = pc.cap * abs(dout - din) / gain();
            d = clamp(d, -lim, lim);
        }
        M = max(P.rgb + encode_as_proxy(max(p + d, vec3(0.0))) - encode_as_proxy(p), vec3(0.0));
        if (!finite(M)) M = P.rgb;
    }
    imageStore(a, xy, vec4(M, nout.a));
#endif
}
