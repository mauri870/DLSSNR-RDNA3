#version 460
#extension GL_GOOGLE_include_directive : require
// Mode 34 (ours), Enlargement "Classic" (Transfer 4) below the frame's extent: t0 = the network's answer at the model's
// extent -> u0 at the frame's (Width x Height), in the answer's own (display-encoded) values; the resolve then composes
// that picture (wilsjo2_resolve.comp, Transfer 4). The scaler is DebugView: 0 bilinear, 1 Catmull-Rom (separable 4x4,
// B = 0, C = 0.5), 2 Lanczos3 (separable 6x6), 3 FSR 1 EASU (AMD FidelityFX Super Resolution 1.0, include/fsr1, MIT).
// The first three are clamped to the 2x2 texels around the sample, as EASU clamps itself: a ringing lobe would be a
// halo the network never drew. (The ReShade route's former runtime_upscale.comp, which this replaced, the same way.)
#include "wilsjo2_common.glsl"

ivec2 model_size() { return textureSize(t0, 0); }
vec3 fetch(ivec2 p) { return texelFetch(t0, clamp(p, ivec2(0), model_size() - 1), 0).rgb; }

// ---- FSR 1 EASU ----------------------------------------------------------------------------------
#define A_GPU 1
#define A_GLSL 1
#include "fsr1/ffx_a.h"
#define FSR_EASU_F 1
// textureGather's footprint for the texel square containing `p` (normalised coordinates):
// x = (0,1), y = (1,1), z = (1,0), w = (0,0) relative to the lower-left texel.
ivec2 gather_base(AF2 p) { return ivec2(floor(p * vec2(model_size()) - 0.5)); }
AF4 gather(AF2 p, int c) {
    const ivec2 b = gather_base(p);
    return AF4(fetch(b + ivec2(0, 1))[c], fetch(b + ivec2(1, 1))[c], fetch(b + ivec2(1, 0))[c], fetch(b)[c]);
}
AF4 FsrEasuRF(AF2 p) { return gather(p, 0); }
AF4 FsrEasuGF(AF2 p) { return gather(p, 1); }
AF4 FsrEasuBF(AF2 p) { return gather(p, 2); }
#include "fsr1/ffx_fsr1.h"

vec3 easu(ivec2 xy) {
    const vec2 m = vec2(model_size());
    AU4 con0, con1, con2, con3;
    FsrEasuCon(con0, con1, con2, con3, AF1(m.x), AF1(m.y), AF1(m.x), AF1(m.y), AF1(cb.Width), AF1(cb.Height));
    AF3 c;
    FsrEasuF(c, AU2(xy), con0, con1, con2, con3);
    return c;
}

// ---- separable kernels ---------------------------------------------------------------------------
float catmull_rom(float x) {
    x = abs(x);
    if (x < 1.0) return 1.5 * x * x * x - 2.5 * x * x + 1.0;
    if (x < 2.0) return -0.5 * x * x * x + 2.5 * x * x - 4.0 * x + 2.0;
    return 0.0;
}
float lanczos3(float x) {
    x = abs(x);
    if (x < 1e-5) return 1.0;
    if (x >= 3.0) return 0.0;
    const float px = 3.14159265358979 * x;
    return 3.0 * sin(px) * sin(px / 3.0) / (px * px);
}
float kernel(int radius, float x) {
    if (radius == 1) return max(0.0, 1.0 - abs(x));   // bilinear
    return radius == 2 ? catmull_rom(x) : lanczos3(x);
}

vec3 separable(ivec2 xy, int radius) {
    const vec2 p = (vec2(xy) + 0.5) * (vec2(model_size()) / vec2(float(cb.Width), float(cb.Height))) - 0.5;
    const ivec2 base = ivec2(floor(p));
    const vec2 f = p - vec2(base);
    vec3 sum = vec3(0.0);
    float wsum = 0.0;
    for (int j = 1 - radius; j <= radius; ++j) {
        const float wy = kernel(radius, float(j) - f.y);
        for (int i = 1 - radius; i <= radius; ++i) {
            const float w = wy * kernel(radius, float(i) - f.x);
            sum += w * fetch(base + ivec2(i, j));
            wsum += w;
        }
    }
    vec3 c = sum / wsum;
    const vec3 a = fetch(base), b = fetch(base + ivec2(1, 0)), d = fetch(base + ivec2(0, 1)), e = fetch(base + ivec2(1, 1));
    return clamp(c, min(min(a, b), min(d, e)), max(max(a, b), max(d, e)));
}

void main() {
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (outside(p)) return;
    const ivec2 xy = ivec2(p);
    const uint scaler = cb.DebugView;
    const vec3 c = scaler == 3u ? easu(xy) : separable(xy, scaler == 2u ? 3 : scaler == 1u ? 2 : 1);
    imageStore(u0, xy, vec4(c, 1.0));
}
