#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
// Preprocess ([Preprocess] in dlssnr-amd.ini) with the RenoDX-style option ([RenoDX], linux/src/core/nr_renodx.cpp).
// The math of prep_math.glsl, placed around RenoDX's processing:
//
//   linear HDR (RenoDX's v6 codec): the frame x before RenoDX's encode becomes forward(x) (mode 1: a -> b); RenoDX's
//     encode then reads that. The _prep resolve maps N and P through the bounded inverse before forming a ratio
//     (or keeps a proxy-domain ratio with Inverse off). With exposure off (NORMALISE) x is first brought
//     to the units RenoDX's encode works in - divided by its divisor (`divisor`, else the 1x1 scale texel `Scale`
//     as v6_encode reads it) - so the curve and the contrast see the frame RenoDX would show the network.
//   SDR (RenoDX's legacy codec, which takes the network's answer whole): on the network's input
//     in place, P kept (mode 1: a in place, b = P), and the change taken back out of the answer (mode 2: a the
//     network's input, b = P, c the answer; RESTORE puts P back into a for what follows). APART: mode 1 leaves a
//     (= P) as it is and stores the network's input into b, so nothing has to be kept or put back.
//
// Mode 0 meters `a` (one workgroup), prep_math.glsl's meter().
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, std430) buffer State { float s[4]; } st;   // smoothed log2 gain, valid, gain, target
layout(set = 0, binding = 1, rgba16f) uniform image2D a;
layout(set = 0, binding = 2, rgba16f) uniform image2D b;
layout(set = 0, binding = 3, rgba16f) uniform image2D c;
layout(set = 0, binding = 4) uniform texture2D Scale;   // RenoDX's same-frame scale (NORMALISE, divisor 0)
layout(push_constant) uniform Push {
    uint width, height, mode, flags, curve;
    float bias, contrast, saturation, k, cap;
    float dt;
    float divisor;   // NORMALISE: RenoDX's divisor, 0 = the scale texel
} pc;

const uint AUTO = 1u, UNKNEE = 2u, RESTORE = 4u, RESET = 8u, LINEAR = 16u, NORMALISE = 32u, RATIO = 64u, APART = 128u, RECOMPUTE = 256u;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

// The frame's encoding: sRGB for an SDR frame, none for RenoDX's linear work surface (LINEAR).
vec3 enc(vec3 v) {
    v = clamp(v, 0.0, 1.0);
    return mix(v * 12.92, 1.055 * pow(max(v, vec3(1e-8)), vec3(1.0 / 2.4)) - 0.055, step(0.0031308, v));
}
vec3 dec(vec3 v) {
    v = clamp(v, 0.0, 1.0);
    return mix(v / 12.92, pow((v + 0.055) / 1.055, vec3(2.4)), step(0.04045, v));
}
// Never set here (the former runtime Preprocess pass's OptiScaler soft knee); kept so the shared math reads the same.
vec3 knee(vec3 d) { return d; }
vec3 knee_inv(vec3 d) { return d; }
bool unknee() { return false; }
bool linear_frame() { return (pc.flags & LINEAR) != 0u; }
vec3 light(vec3 P) { return linear_frame() ? max(P, vec3(0.0)) : dec(P); }
vec3 reencode(vec3 v) { return linear_frame() ? v : enc(v); }
vec3 light_at(vec3 P, ivec2 xy) { return light(P); }   // prep_math.glsl's meter: no kept frame here

#include "prep_math.glsl"

// The half an rgba16f store keeps of v on RDNA4 (its conversion is toward zero): normal halves keep 10 mantissa bits,
// below 2^-14 the multiples of 2^-24. Checked against the store for every float in [0, 1].
vec3 half_rtz(vec3 v) {
    return mix(trunc(v * 16777216.0) * 5.9604644775390625e-08, uintBitsToFloat(floatBitsToUint(v) & 0xffffe000u),
               greaterThanEqual(abs(v), vec3(6.103515625e-05)));
}

void main() {
    if (pc.mode == 0u) { meter(); return; }
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= int(pc.width) || xy.y >= int(pc.height)) return;
    if (pc.mode == 1u) {
        const vec4 P = imageLoad(a, xy);
        if (linear_frame()) {
            vec3 x = light(P.rgb);
            if ((pc.flags & NORMALISE) != 0u)
                x /= pc.divisor > 0.0 ? pc.divisor : max(texelFetch(Scale, ivec2(0), 0).r, 1e-8);
            imageStore(b, xy, finite(P.rgb) ? vec4(forward(x), P.a) : P);
            return;
        }
        if ((pc.flags & APART) != 0u) {
            imageStore(b, xy, finite(P.rgb) ? vec4(enc(forward(light(P.rgb))), P.a) : P);
            return;
        }
        imageStore(b, xy, P);
        if (!finite(P.rgb)) return;
        imageStore(a, xy, vec4(enc(forward(light(P.rgb))), P.a));
        return;
    }
    const vec4 nout = imageLoad(c, xy), P = imageLoad(b, xy);
    vec4 nin;
    if ((pc.flags & RECOMPUTE) != 0u) {   // the network's input made again from P as mode 1 stored it (half floats)
        nin = finite(P.rgb) ? vec4(half_rtz(enc(forward(light(P.rgb)))), P.a) : P;
    } else {
        nin = imageLoad(a, xy);
    }
    vec3 M = P.rgb;
    if (nout.rgb != nin.rgb && finite(nout.rgb) && finite(P.rgb)) {
        const vec3 din = dec(nin.rgb), dout = dec(nout.rgb);
        const vec3 p = light(P.rgb);
        vec3 d;
        if ((pc.flags & RATIO) != 0u) {
            // [Preprocess] Inverse = 0: the change as its ratio in the picture the network was shown
            d = p * (clamp(max(dout, vec3(1.0 / 1024.0)) / max(din, vec3(1.0 / 1024.0)), 0.25, 4.0) - 1.0);
        } else {
            d = backward(dout) - backward(din);
            const vec3 lim = pc.cap * abs(dout - din) / gain();
            d = clamp(d, -lim, lim);
        }
        M = max(P.rgb + reencode(max(p + d, vec3(0.0))) - reencode(p), vec3(0.0));
        if (!finite(M)) M = P.rgb;
    }
    imageStore(c, xy, vec4(M, nout.a));
    if ((pc.flags & RESTORE) != 0u) imageStore(a, xy, P);
}
